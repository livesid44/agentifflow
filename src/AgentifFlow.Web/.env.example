# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and will NOT be committed.

# Azure AD app registration (SPA app)
VITE_AAD_CLIENT_ID=YOUR_CLIENT_ID
VITE_AAD_TENANT_ID=YOUR_TENANT_ID

# API app registration client ID (the backend "api://" scope owner)
VITE_API_CLIENT_ID=YOUR_API_CLIENT_ID

# Base URL of the AgentifFlow backend
VITE_API_BASE_URL=http://localhost:5000
