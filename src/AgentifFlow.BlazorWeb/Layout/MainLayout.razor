@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                               Edge="Edge.Start" OnClick="ToggleDrawer" />
            </Authorized>
        </AuthorizeView>
        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Inherit" Class="mr-2" />
        <MudText Typo="Typo.h6" Style="font-weight:700;letter-spacing:-0.3px;">AgentifFlow</MudText>
        <MudSpacer />
        <LoginDisplay />
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
                <MudNavMenu>
                    <MudNavLink Href="/" Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Outlined.Dashboard">
                        Dashboard
                    </MudNavLink>
                    <MudNavLink Href="/configuration" Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Outlined.Settings">
                        Integration Settings
                    </MudNavLink>
                    <MudNavLink Href="/agent-configuration" Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Outlined.SmartToy">
                        Agent Configuration
                    </MudNavLink>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
            @Body
        </MudContainer>

        <!-- ── Footer ────────────────────────────────────────────────────────── -->
        <footer class="app-footer">
            <span>Powered by</span>
            <svg width="18" height="18" viewBox="0 0 36 36" fill="none" aria-hidden="true" style="margin:0 4px;">
                <rect width="36" height="36" rx="7" fill="#E31937"/>
                <path d="M9 27 L18 8 L27 27" stroke="white" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="18" cy="21" r="3.5" fill="white"/>
            </svg>
            <strong>Tech M Orion Marketplace</strong>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
