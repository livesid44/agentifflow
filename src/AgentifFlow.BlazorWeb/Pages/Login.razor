                <rect x="-6.5" y="-2" width="13" height="10" rx="2" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none"/>
                <path d="M-4,-2 V-6 A4,4,0,0,1,4,-6 V-2" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                <rect x="-1.5" y="1.5" width="3" height="3.5" rx="1" fill="rgba(255,255,255,0.68)"/>
            </g>

            <!-- Chat — upper-right (367, 133) -->
            <g transform="translate(367,133)">
                <rect x="-9" y="-8" width="18" height="13" rx="3" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none"/>
                <circle cx="-4" cy="-1.5" r="1.5" fill="rgba(255,255,255,0.68)"/>
                <circle cx="0"  cy="-1.5" r="1.5" fill="rgba(255,255,255,0.68)"/>
                <circle cx="4"  cy="-1.5" r="1.5" fill="rgba(255,255,255,0.68)"/>
                <path d="M-6,5 L-9,9 L-0.5,5" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
            </g>

            <!-- Search — right (415, 250) -->
