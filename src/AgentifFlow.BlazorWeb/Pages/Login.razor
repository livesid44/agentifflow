            <line x1="250" y1="250" x2="367" y2="133" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>
            <line x1="250" y1="250" x2="415" y2="250" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>
            <line x1="250" y1="250" x2="367" y2="367" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>
            <line x1="250" y1="250" x2="250" y2="415" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>
            <line x1="250" y1="250" x2="133" y2="367" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>
            <line x1="250" y1="250" x2="85"  y2="250" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>
            <line x1="250" y1="250" x2="133" y2="133" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>

            <!-- Icon circle backgrounds -->
            <circle cx="250" cy="85"  r="30" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
            <circle cx="367" cy="133" r="30" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
            <circle cx="415" cy="250" r="30" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
            <circle cx="367" cy="367" r="30" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
            <circle cx="250" cy="415" r="30" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
            <circle cx="133" cy="367" r="30" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
            <circle cx="85"  cy="250" r="30" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>
            <circle cx="133" cy="133" r="30" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.18)" stroke-width="1"/>

            <!-- Lock — top (250, 85) -->
