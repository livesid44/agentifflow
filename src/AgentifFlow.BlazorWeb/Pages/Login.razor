            <!-- Gear — lower-right (367, 367) -->
            <g transform="translate(367,367)">
                <circle r="5"   stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none"/>
                <circle r="8.5" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none" stroke-dasharray="5.3 2.7"/>
            </g>

            <!-- Network/Wifi — bottom (250, 415) -->
            <g transform="translate(250,415)">
                <path d="M-8,-4 A9.4,9.4,0,0,1,8,-4"   stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                <path d="M-5,-1 A5.9,5.9,0,0,1,5,-1"   stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                <path d="M-2.5,2 A3,3,0,0,1,2.5,2"     stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                <circle cy="6" r="2" fill="rgba(255,255,255,0.68)"/>
            </g>

            <!-- Envelope — lower-left (133, 367) -->
            <g transform="translate(133,367)">
                <rect x="-9" y="-6" width="18" height="13" rx="1.5" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none"/>
                <path d="M-9,-6 L0,2 L9,-6" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
            </g>

            <!-- Globe — left (85, 250) -->
            <g transform="translate(85,250)">
                <circle r="9" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none"/>
                <ellipse rx="4.5" ry="9" stroke="rgba(255,255,255,0.45)" stroke-width="1" fill="none"/>
                <line x1="-9" y1="0"      x2="9"   y2="0"    stroke="rgba(255,255,255,0.40)" stroke-width="1"/>
                <line x1="-7.5" y1="-4.5" x2="7.5" y2="-4.5" stroke="rgba(255,255,255,0.25)" stroke-width="0.8"/>
                <line x1="-7.5" y1="4.5"  x2="7.5" y2="4.5"  stroke="rgba(255,255,255,0.25)" stroke-width="0.8"/>
            </g>

            <!-- Chip — upper-left (133, 133) -->
            <g transform="translate(133,133)">
                <rect x="-7" y="-7" width="14" height="14" rx="2" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" fill="none"/>
                <rect x="-4" y="-4" width="8"  height="8"  rx="1" stroke="rgba(255,255,255,0.45)" stroke-width="1"   fill="none"/>
                <line x1="-7"  y1="-3" x2="-11" y2="-3" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="-7"  y1="0"  x2="-11" y2="0"  stroke="rgba(255,255,255,0.68)" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="-7"  y1="3"  x2="-11" y2="3"  stroke="rgba(255,255,255,0.68)" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="7"   y1="-3" x2="11"  y2="-3" stroke="rgba(255,255,255,0.68)" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="7"   y1="0"  x2="11"  y2="0"  stroke="rgba(255,255,255,0.68)" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="7"   y1="3"  x2="11"  y2="3"  stroke="rgba(255,255,255,0.68)" stroke-width="1.5" stroke-linecap="round"/>
            </g>

            <!-- Central AI element -->
            <circle cx="250" cy="250" r="45" fill="rgba(227,25,55,0.10)" stroke="rgba(227,25,55,0.35)" stroke-width="1.5"/>
            <text x="250" y="256" text-anchor="middle" dominant-baseline="middle"
                  font-size="24" font-weight="800" fill="rgba(255,255,255,0.92)"
                  font-family="'Roboto',system-ui,sans-serif">AI</text>

            <!-- Gear above AI -->
            <circle cx="250" cy="212" r="9" stroke="rgba(255,255,255,0.30)" stroke-width="1.5" fill="none"/>
            <circle cx="250" cy="212" r="4" fill="rgba(255,255,255,0.15)"/>
            <rect x="-2" y="-13.5" width="4" height="4" rx="1" fill="rgba(255,255,255,0.35)" transform="translate(250,212) rotate(0)"/>
            <rect x="-2" y="-13.5" width="4" height="4" rx="1" fill="rgba(255,255,255,0.35)" transform="translate(250,212) rotate(60)"/>
            <rect x="-2" y="-13.5" width="4" height="4" rx="1" fill="rgba(255,255,255,0.35)" transform="translate(250,212) rotate(120)"/>
            <rect x="-2" y="-13.5" width="4" height="4" rx="1" fill="rgba(255,255,255,0.35)" transform="translate(250,212) rotate(180)"/>
            <rect x="-2" y="-13.5" width="4" height="4" rx="1" fill="rgba(255,255,255,0.35)" transform="translate(250,212) rotate(240)"/>
            <rect x="-2" y="-13.5" width="4" height="4" rx="1" fill="rgba(255,255,255,0.35)" transform="translate(250,212) rotate(300)"/>

            <!-- Circuit lines below AI -->
            <line x1="250" y1="295" x2="250" y2="316" stroke="rgba(255,255,255,0.20)" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="228" y1="310" x2="272" y2="310" stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
            <circle cx="228" cy="310" r="3" fill="rgba(255,255,255,0.15)"/>
            <circle cx="272" cy="310" r="3" fill="rgba(255,255,255,0.15)"/>
        </svg>

    </div>

    <!-- ── Right: Dark Form Panel ───────────────────────────────────────────── -->
    <div class="login-form-panel-dark">

        <!-- Top-right corner logo — Tech M Orion Marketplace -->
        <div class="lp-corner-logo">
            <svg width="34" height="34" viewBox="0 0 36 36" fill="none" aria-hidden="true">
                <rect width="36" height="36" rx="6" fill="#E31937"/>
                <path d="M9 27 L18 8 L27 27" stroke="white" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="18" cy="21" r="3.5" fill="white"/>
            </svg>
            <div class="lp-logo-text">
                <span class="lp-logo-l1">TECH M ORION</span>
                <span class="lp-logo-l2">Marketplace</span>
            </div>
        </div>

        <!-- Body -->
        <div class="lp-form-body">

            <!-- Mobile-only logo -->
            <div class="lp-mob-logo">
                <svg width="40" height="40" viewBox="0 0 36 36" fill="none">
                    <rect width="36" height="36" rx="7" fill="#E31937"/>
                    <path d="M9 27 L18 8 L27 27" stroke="white" stroke-width="2.5"
                          stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="18" cy="21" r="3.5" fill="white"/>
                </svg>
            </div>

            <h1 class="lp-heading">
                Agentif<span class="lp-red">Flow</span>
            </h1>
            <p class="lp-sub">AI Workflow Platform</p>
            <p class="lp-tagline">Agentify your Business</p>

            <hr class="lp-hr"/>

            @if (_useDevLogin)
            {
                <!-- Dev mode warning -->
                <div class="lp-dev-warn">
                    <strong>Developer mode</strong> — local credentials only. Not for production.
                </div>

                <input type="text" class="lp-input" placeholder="Username"
                       @bind="@_username" @bind:event="oninput" />
                <input type="password" class="lp-input" placeholder="Password"
                       @bind="@_password" @bind:event="oninput"
                       @onkeydown="HandleKeyDown" />

                <button class="btn-lp-red" @onclick="DevLogin" disabled="@_logging">
                    @if (_logging)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                             Color="Color.Inherit" Class="me-2"/>
                        <span>Signing in…</span>
                    }
                    else
                    {
                        <span>Login Now</span>
                    }
                </button>

                <p class="lp-dev-note">
                    Configure credentials in <code>appsettings.Development.json → DevAuth</code>
                </p>
            }
            else
            {
                <p class="lp-already">Already signed up?</p>
                <button class="btn-lp-red" @onclick="SignIn">
                    <svg width="20" height="20" viewBox="0 0 21 21" aria-hidden="true">
                        <rect x="1"  y="1"  width="9" height="9" fill="#f25022"/>
                        <rect x="11" y="1"  width="9" height="9" fill="#7fba00"/>
                        <rect x="1"  y="11" width="9" height="9" fill="#00a4ef"/>
                        <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                    </svg>
                    Login Now
                </button>

                <div class="lp-or-row">OR</div>

                <h3 class="lp-create-h">New to AgentifFlow?</h3>
                <p class="lp-create-p">
                    We're glad you're here.<br/>
                    Contact your Azure AD administrator to provision your account.
                </p>

                <p class="lp-secure">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                    </svg>
                    Secured by Azure Active Directory OAuth 2.0
                </p>
            }

        </div>

        <!-- Footer -->
        <div class="lp-form-footer">
            <p class="lp-footer-p">
                <strong>If your company is not onboarded yet,<br/>
                please reach out to your sales team.</strong>
            </p>
            <button class="btn-lp-outline">Request Access</button>
        </div>

    </div>

</div>

@code {
    private bool   _useDevLogin;
    private string _username = "";
    private string _password = "";
    private bool   _logging;

    protected override void OnInitialized()
    {
        _useDevLogin = Config.GetValue<bool>("ApiConfig:EnableDevLogin");
    }

    // ── OAuth2 sign-in ────────────────────────────────────────────────────────
    private void SignIn() => Navigation.NavigateToLogin("authentication/login");

    // ── Dev local sign-in ─────────────────────────────────────────────────────
    private async Task DevLogin()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("Please enter both username and password.", Severity.Warning);
            return;
        }

        _logging = true;
        try
        {
            var authSvc = Services.GetRequiredService<ILocalAuthApiService>();
            var result  = await authSvc.LoginAsync(_username, _password);
            if (result is null)
            {
                Snackbar.Add(
                    "Invalid credentials. Verify DevAuth settings in appsettings.Development.json.",
                    Severity.Error);
                return;
            }

            var provider = Services.GetRequiredService<LocalAuthStateProvider>();
            await provider.LoginAsync(result.Token);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Login failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _logging = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DevLogin();
    }
}
