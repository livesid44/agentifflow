@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject NavigationManager Navigation
@inject IConfiguration Config
@inject IServiceProvider Services
@inject ISnackbar Snackbar

<div class="login-page-split">

    <!-- ── Left Hero Panel ──────────────────────────────────────────────── -->
    <div class="login-hero-panel">
        <div class="login-hero-orb login-hero-orb-1"></div>
        <div class="login-hero-orb login-hero-orb-2"></div>

        <!-- Logo mark -->
        <div class="login-hero-logo">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
                <rect width="56" height="56" rx="15"
                      fill="rgba(255,255,255,0.10)"
                      stroke="rgba(255,255,255,0.18)" stroke-width="1" />
                <path d="M14 42 L28 13 L42 42"
                      stroke="white" stroke-width="3.5"
                      stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="28" cy="33" r="5.5" fill="white" />
            </svg>
        </div>

        <h1 class="login-hero-title">AgentifFlow</h1>
        <p class="login-hero-sub">
            AI-powered workflow automation<br />
            with Azure integration
        </p>

        <ul class="login-hero-features">
            <li><span class="login-hero-feat-icon">📧</span> Microsoft 365 Mail via Graph API</li>
            <li><span class="login-hero-feat-icon">🤖</span> Azure OpenAI LLM integration</li>
            <li><span class="login-hero-feat-icon">☁️</span> Azure Blob Storage monitoring</li>
            <li><span class="login-hero-feat-icon">🗄️</span> SQL Database persistence</li>
        </ul>

        <p class="login-hero-edition">Enterprise Edition</p>
    </div>

    <!-- ── Right Form Panel ─────────────────────────────────────────────── -->
    <div class="login-form-panel">

        <!-- Mobile-only logo (hidden on desktop where the hero panel shows) -->
        <div class="login-form-mobile-logo">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
                <rect width="44" height="44" rx="12" fill="#4F46E5" />
                <path d="M11 33 L22 10 L33 33"
                      stroke="white" stroke-width="3"
                      stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="22" cy="25" r="4.5" fill="white" />
            </svg>
        </div>

        <div class="login-form-inner">
            <h2 class="login-form-heading">Welcome back</h2>
            <p class="login-form-hint">
                Sign in with your Microsoft account to access the platform
            </p>

            @if (_useDevLogin)
            {
                <!-- ── Dev local login form ─────────────────────────────── -->
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-5">
                    <strong>Developer mode</strong> — local credentials only.
                    Not for production use.
                </MudAlert>

                <MudTextField @bind-Value="_username"
                              Label="Username"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Class="mb-3"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              Disabled="@_logging" />

                <MudTextField @bind-Value="_password"
                              Label="Password"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              FullWidth="true"
                              Class="mb-5"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Disabled="@_logging"
                              OnKeyDown="HandleKeyDown" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="DevLogin"
                           Disabled="@_logging"
                           Style="height:52px; font-size:1rem; border-radius:10px;">
                    @if (_logging)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                             Color="Color.Inherit" Class="me-2" />
                        <span>Signing in…</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Login" Class="me-2" />
                        <span>Sign In (Dev)</span>
                    }
                </MudButton>

                <MudText Typo="Typo.caption" Class="mt-4 d-block"
                         Style="color:var(--mud-palette-text-disabled);">
                    Configure credentials in <code>appsettings.Development.json → DevAuth</code>
                </MudText>
            }
            else
            {
                <!-- ── Microsoft / Azure AD sign-in ─────────────────────── -->
                <button class="login-ms-btn" @onclick="SignIn">
                    <svg width="21" height="21" viewBox="0 0 21 21" fill="none">
                        <rect x="1"  y="1"  width="9" height="9" fill="#f25022" />
                        <rect x="11" y="1"  width="9" height="9" fill="#7fba00" />
                        <rect x="1"  y="11" width="9" height="9" fill="#00a4ef" />
                        <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
                    </svg>
                    <span>Sign in with Microsoft</span>
                </button>

                <p class="login-secure-txt">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z" />
                    </svg>
                    Secured by Azure Active Directory OAuth 2.0
                </p>
            }
        </div>
    </div>

</div>

@code {
    private bool   _useDevLogin;
    private string _username = "";
    private string _password = "";
    private bool   _logging;

    protected override void OnInitialized()
    {
        _useDevLogin = Config.GetValue<bool>("ApiConfig:EnableDevLogin");
    }

    // ── OAuth2 sign-in (non-dev mode) ─────────────────────────────────────────
    private void SignIn() => Navigation.NavigateToLogin("authentication/login");

    // ── Dev local sign-in ─────────────────────────────────────────────────────
    private async Task DevLogin()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("Please enter both username and password.", Severity.Warning);
            return;
        }

        _logging = true;
        try
        {
            var authSvc = Services.GetRequiredService<ILocalAuthApiService>();
            var result  = await authSvc.LoginAsync(_username, _password);
            if (result is null)
            {
                Snackbar.Add(
                    "Invalid credentials. Verify DevAuth settings in appsettings.Development.json.",
                    Severity.Error);
                return;
            }

            var provider = Services.GetRequiredService<LocalAuthStateProvider>();
            await provider.LoginAsync(result.Token);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Login failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _logging = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DevLogin();
    }
}
