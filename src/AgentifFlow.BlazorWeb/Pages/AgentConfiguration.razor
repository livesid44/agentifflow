@page "/agent-configuration"
@attribute [Authorize]
@inject IConfigurationApiService ConfigService
@inject ISnackbar Snackbar

<PageTitle>Agent Configuration</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1" Style="font-weight:700; letter-spacing:-0.5px;">
    Agent Configuration
</MudText>
<MudText Typo="Typo.body2" Class="mb-6" Style="color:var(--mud-palette-text-secondary);">
    Configure the background worker settings. Changes take effect immediately.
</MudText>

@if (_loading)
{
    <div class="d-flex justify-center mt-16">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    </div>
}
else if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_loadError</MudAlert>
}
else
{
    <MudPaper Elevation="2" Class="pa-6 rounded-lg mb-6">

        <!-- Enable / disable toggle -->
        <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight:700;">
            <MudIcon Icon="@Icons.Material.Outlined.SmartToy" Class="mr-2" Style="vertical-align:middle;" />
            Agent Flow Worker
        </MudText>

        <MudGrid Spacing="4">
            <MudItem xs="12">
                <MudSwitch @bind-Value="_agentFlowEnabled"
                           Label="Enable Agent Flow"
                           Color="Color.Primary" />
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);">
                    When enabled the background worker polls Blob Storage and processes CSV files automatically.
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_pollInterval"
                                 Label="Poll Interval (seconds)"
                                 Placeholder="60"
                                 Min="10" Max="3600"
                                 HelperText="How often the background worker checks Blob Storage for new CSV files."
                                 Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_maxRetries"
                                 Label="Max Retries"
                                 Placeholder="3"
                                 Min="0" Max="10"
                                 HelperText="Maximum number of automatic retry attempts for failed SQL inserts."
                                 Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_notificationEmail"
                              Label="Notification Email"
                              InputType="InputType.Email"
                              Placeholder="alerts@contoso.com"
                              HelperText="Email address that receives CSV validation failure alerts."
                              Variant="Variant.Outlined" FullWidth="true" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- ── Footer / Save ─────────────────────────────────────────────────────── -->
    <div class="d-flex justify-end align-center flex-wrap gap-4">
        @if (_savedAt is not null)
        {
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-disabled);">
                Last saved: @_savedAt
            </MudText>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   OnClick="HandleSave"
                   Disabled="@_saving"
                   StartIcon="@(_saved ? Icons.Material.Filled.Check : Icons.Material.Filled.Save)">
            @if (_saving)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"
                                     Color="Color.Inherit" />
                <span class="ms-2">Saving…</span>
            }
            else if (_saved)
            {
                <span>Saved!</span>
            }
            else
            {
                <span>Save Configuration</span>
            }
        </MudButton>
    </div>
}

@code {
    private bool   _agentFlowEnabled;
    private int    _pollInterval = 60;
    private int    _maxRetries   = 3;
    private string _notificationEmail = "";

    private bool _loading = true;
    private string? _loadError;
    private bool _saving;
    private bool _saved;
    private string? _savedAt;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var config = await ConfigService.GetConfigurationAsync();
            if (config is not null)
            {
                _agentFlowEnabled  = config.AgentFlowEnabled;
                _pollInterval      = config.BlobPollIntervalSeconds > 0 ? config.BlobPollIntervalSeconds : 60;
                _maxRetries        = config.MaxRetryCount > 0 ? config.MaxRetryCount : 3;
                _notificationEmail = config.NotificationEmail ?? "";
                if (config.UpdatedAt.HasValue)
                    _savedAt = config.UpdatedAt.Value.ToLocalTime().ToString();
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSave()
    {
        _saving = true;
        _saved  = false;

        // Load current config so we don't overwrite other fields
        try
        {
            var existing = await ConfigService.GetConfigurationAsync();
            var request  = new UpdateAppConfigurationRequest
            {
                GraphTenantId        = existing?.GraphTenantId ?? "",
                GraphClientId        = existing?.GraphClientId ?? "",
                GraphScopes          = existing?.GraphScopes ?? "",
                OpenAiEndpoint       = existing?.OpenAiEndpoint ?? "",
                OpenAiDeploymentName = existing?.OpenAiDeploymentName ?? "",
                BlobContainerName    = existing?.BlobContainerName ?? "",
                AgentFlowEnabled        = _agentFlowEnabled,
                BlobPollIntervalSeconds = _pollInterval,
                MaxRetryCount           = _maxRetries,
                NotificationEmail       = _notificationEmail,
            };

            var saved = await ConfigService.SaveConfigurationAsync(request);
            if (saved?.UpdatedAt is not null)
                _savedAt = saved.UpdatedAt.Value.ToLocalTime().ToString();
            _saved = true;
            Snackbar.Add("Agent configuration saved!", Severity.Success);
            await Task.Delay(3000);
            _saved = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
